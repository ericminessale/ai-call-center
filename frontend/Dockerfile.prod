# Production frontend image (DEPLOY-C4).
#
# The dev image runs `npm run dev` (Vite dev server: HMR, source maps,
# unminified bundle) and was what the stack served publicly. This builds the
# real minified bundle and serves it as static files via a tiny nginx, so the
# public site is a production build. The main reverse-proxy nginx proxies
# `location /` to this container on :3000 exactly as it did to the dev server.
#
# Same-origin design: the SPA talks to /api and /socket.io on its own origin
# (see services/api.ts + services/websocket.ts), so no VITE_API_URL/VITE_WS_URL
# is baked in — leaving them unset makes the app use relative URLs + origin,
# which becomes https/wss automatically behind TLS (DEPLOY-M5).

# ---- build stage ----
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# Optional build-time public config. Safe to leave empty for same-origin.
ARG VITE_SIGNALWIRE_HOST
ARG VITE_SIGNALWIRE_PHONE_NUMBER
ARG VITE_FABRIC_APPLICATION_ID
RUN npm run build

# ---- serve stage ----
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
