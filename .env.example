# SignalWire AI Call Center Configuration
# Copy this file to .env and fill in your values

# ======================
# SignalWire Configuration (REQUIRED)
# ======================
# Your SignalWire Space (e.g., yourspace.signalwire.com)
SIGNALWIRE_SPACE=your-space.signalwire.com

# Project ID from SignalWire Dashboard
SIGNALWIRE_PROJECT_ID=your-project-id-here

# API Token from SignalWire Dashboard
SIGNALWIRE_API_TOKEN=your-api-token-here

# Phone number for outbound calls (E.164 format)
SIGNALWIRE_PHONE_NUMBER=+1234567890

# ======================
# Database Configuration
# ======================
POSTGRES_DB=callcenter
POSTGRES_USER=ccuser
POSTGRES_PASSWORD=changeme-in-production
DATABASE_URL=postgresql://ccuser:changeme-in-production@postgres:5432/callcenter

# ======================
# Security Configuration
# ======================
# JWT Secret + Flask secret. The backend FAILS to start if either is missing.
# Generate fresh values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
SECRET_KEY=

# CORS allowlist (comma-separated). Browsers reject wildcard (*) when
# credentials are enabled, so list specific origins. The default below covers
# nginx (port 80), the Flask dev port, and Vite. Add any production domain.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Webhook auth — protects the SignalWire-facing webhook + queue routes
# (/api/webhooks/* and /api/queues/<id>/route). Producers (this backend and
# the AI agents) embed these credentials in the URLs they hand SignalWire,
# and SignalWire replays them as HTTP Basic Auth on the callback. Generate
# a fresh password with the same secrets.token_urlsafe trick above. Set
# WEBHOOK_AUTH_REQUIRED=true to reject unauthenticated webhooks; leave
# unset / 'false' for soft mode (warns but accepts) while rolling out.
WEBHOOK_AUTH_USER=signalwire
WEBHOOK_AUTH_PASSWORD=
WEBHOOK_AUTH_REQUIRED=false

# ======================
# AI Agent Authentication
# ======================
# HTTP Basic Auth for AI agent webhooks
# SignalWire will use these to authenticate webhook requests
SWML_BASIC_AUTH_USER=agent
SWML_BASIC_AUTH_PASSWORD=agent123

# ======================
# Call Fabric Configuration
# ======================
# Encryption key for storing subscriber passwords securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SUBSCRIBER_PASSWORD_KEY=your-generated-fernet-key-here

# OAuth settings (optional - for advanced Fabric features)
FABRIC_CLIENT_ID=your-fabric-client-id
FABRIC_CLIENT_SECRET=your-fabric-client-secret
FABRIC_REDIRECT_URI=http://localhost:3000/callback

# ======================
# Frontend Configuration
# ======================
# These VITE_ prefixed vars are used by the React frontend
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
VITE_SIGNALWIRE_HOST=your-space.signalwire.com
VITE_SIGNALWIRE_PHONE_NUMBER=+1234567890

# ======================
# Application Settings
# ======================
FLASK_ENV=development

# ======================
# External URL (REQUIRED for local development)
# ======================
# Your ngrok HTTPS URL — used by backend to construct webhook URLs
# that SignalWire can reach (e.g., for SWML callbacks and queue routing)
EXTERNAL_URL=https://your-ngrok-url.ngrok-free.app

# Agent Base URL — externally accessible URL for AI agent transfers
# Should be the same ngrok URL (nginx routes /receptionist, /sales-ai, etc. to ai-agents)
AGENT_BASE_URL=https://your-ngrok-url.ngrok-free.app

# ======================
# Call Fabric Resources (set up in SignalWire Dashboard)
# ======================
# Agent Conference SWML Resource Address
# 1. Go to SignalWire Dashboard > Resources > Add New > Script > SWML Script
# 2. Set Request URL to: https://your-ngrok-url/api/conferences/agent-conference
# 3. Copy the assigned address (e.g., /public/agent-conference-swml)
AGENT_CONFERENCE_RESOURCE=/public/your-resource-address

# ======================
# Feature Flags
# ======================
ENABLE_CALL_RECORDING=true
ENABLE_TRANSCRIPTION=true
ENABLE_AI_SUMMARY=true
ENABLE_CALLBACK_SCHEDULING=false

# ======================
# Queue Configuration
# ======================
DEFAULT_QUEUE_TIMEOUT_SECONDS=300
DEFAULT_PRIORITY=5
MAX_QUEUE_DEPTH=50

# ======================
# Agent Configuration
# ======================
AGENT_IDLE_TIMEOUT_MINUTES=10
AGENT_WRAP_UP_TIME_SECONDS=30

# ======================
# Monitoring (Optional)
# ======================
SENTRY_DSN=
DATADOG_API_KEY=
