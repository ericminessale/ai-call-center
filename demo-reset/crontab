# Workspace GC (Phase 3 reaper). Output appears in `docker-compose
# logs demo-reset` because we run crond with the foreground flag.
# Hourly (minute 30 so it never collides with the nightly pass):
# reap expired workspaces only — live visitors are untouched.
30 * * * * /usr/local/bin/demo-reset.sh hourly > /proc/1/fd/1 2>&1
# Nightly safety pass at 00:00 UTC: same GC + MAX_WORKSPACES cap
# enforcement + template-workspace interaction hygiene.
0 0 * * * /usr/local/bin/demo-reset.sh nightly > /proc/1/fd/1 2>&1
