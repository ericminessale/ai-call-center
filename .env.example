# SignalWire AI Call Center Configuration
# Copy this file to .env and fill in your values

# ======================
# SignalWire Configuration (REQUIRED)
# ======================
# Your SignalWire Space (e.g., yourspace.signalwire.com)
SIGNALWIRE_SPACE=your-space.signalwire.com

# Project ID from SignalWire Dashboard
SIGNALWIRE_PROJECT_ID=your-project-id-here

# API Token from SignalWire Dashboard
SIGNALWIRE_API_TOKEN=your-api-token-here

# Phone number for outbound calls (E.164 format)
SIGNALWIRE_PHONE_NUMBER=+1234567890

# Caller ID used when the backend places outbound calls (E.164 format).
# REQUIRED for outbound dialing — there is intentionally no default.
# Must be a number owned by this SignalWire space.
SIGNALWIRE_FROM_NUMBER=+1234567890

# ======================
# Database Configuration
# ======================
POSTGRES_DB=callcenter
POSTGRES_USER=ccuser
POSTGRES_PASSWORD=changeme-in-production
DATABASE_URL=postgresql://ccuser:changeme-in-production@postgres:5432/callcenter

# Redis password. REQUIRED by docker-compose.prod.yml (the prod stack starts
# redis with --requirepass and refuses to boot if this is unset). Generate a
# strong value; the dev docker-compose.yml runs redis without a password.
REDIS_PASSWORD=

# ======================
# Security Configuration
# ======================
# JWT Secret + Flask secret. The backend FAILS to start if either is missing.
# Generate fresh values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
SECRET_KEY=

# First admin bootstrap (DEPLOY-C3). entrypoint.sh seeds an admin from these
# after migrations, only if one doesn't already exist. If ADMIN_PASSWORD is
# unset NO admin is created (there is deliberately no default password like the
# old Admin123!). Password must be >= 12 chars. ADMIN_EMAIL defaults to
# admin@callcenter.com if only the password is given.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS allowlist (comma-separated). Browsers reject wildcard (*) when
# credentials are enabled, so list specific origins. The default below covers
# nginx (port 80), the Flask dev port, and Vite. Add any production domain.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Number of trusted reverse-proxy hops in front of the backend (SEC-07).
# 1 (default) = the in-compose nginx that always fronts /api; 2 =
# Cloudflare in front of that; 0 = only if you bypass nginx and hit the
# backend directly. When set, the backend honors X-Forwarded-For/-Proto
# from that many hops so request.is_secure is correct behind TLS
# termination (session cookies get their Secure flag) and rate limiting
# sees real client IPs instead of the proxy's.
TRUSTED_PROXY_COUNT=1

# Optional OpenAI API key for content moderation of user-entered text
# (multilingual, semantic — catches harassment / hate / threats a regex
# blocklist misses). Leave blank to fall back to a small built-in
# profanity list. Not required for normal operation.
OPENAI_API_KEY=

# When true, suppress auto-assignment of queued calls to agents who flip
# "available" — they'll claim manually via the request_next_call socket
# event. Useful for local-sandbox development where you don't want a stale
# call thrown at you the moment you go online. Default off (auto-assign on).
SKIP_AUTO_QUEUE_ASSIGN=false

# Webhook auth — protects the SignalWire-facing webhook + queue routes
# (/api/webhooks/* and /api/queues/<id>/route). Producers (this backend and
# the AI agents) embed these credentials in the URLs they hand SignalWire,
# and SignalWire replays them as HTTP Basic Auth on the callback. Generate
# a fresh password with the same secrets.token_urlsafe trick above.
#
# The backend defaults to ENFORCE mode (since the 2026-06-02 SEC-01 fix):
# unset / leave WEBHOOK_AUTH_REQUIRED unset = enforce, reject unauth
# webhook calls with 401. Set WEBHOOK_AUTH_REQUIRED=false ONLY as a
# temporary downgrade during rollout — e.g. while you confirm every
# producer (your AI agents, the /api/swml/initial-call SWML response,
# any phone-number assignment) is signing its callback URLs. Internal
# routes (/api/internal/*) always enforce regardless of this flag — they
# hold the credential-leak surface the audit closed.
WEBHOOK_AUTH_USER=signalwire
WEBHOOK_AUTH_PASSWORD=

# Internal-API auth — SEGREGATED secret for the private backend⇄agent API
# (/api/internal/*: decrypted MCP creds, agent-assignments, call-context,
# workspace-gc, demo-reset) and the ctk / tap-stream HMAC keys. STRONGLY
# recommended for any public host: the WEBHOOK_AUTH creds above ride
# semi-publicly in the SWML the AI agents hand SignalWire (user:pass@host in
# callback URLs on PUBLIC agent routes), so a distinct internal secret keeps a
# WEBHOOK_AUTH leak from unlocking the internal surface or forging tap/ctk
# tokens. Leave BOTH unset to fall back to WEBHOOK_AUTH_* (existing behavior).
# Set on the shared env so backend + ai-agents + demo-reset all pick it up.
INTERNAL_AUTH_USER=backend-internal
INTERNAL_AUTH_PASSWORD=

# ======================
# Feature flags
# ======================
# Capabilities that ship in the code but stay OFF until production-ready.
# AI Coach (sidecar): targets a pre-release SignalWire verb and bills per
# minute. Off by default EVERYWHERE (hosted demo AND clone-and-own); the UI
# shows a "coming soon" teaser while off. Set true on a NON-demo deployment to
# turn it on (it stays blocked in demo mode regardless).
COACH_ENABLED=false

# ======================
# AI Agent Authentication
# ======================
# HTTP Basic Auth for AI agent webhooks (SignalWire replays these on callbacks).
# DEPLOY-M4: do NOT ship the old agent/agent123 default on a public instance —
# set a real username and a generated password.
SWML_BASIC_AUTH_USER=agent
SWML_BASIC_AUTH_PASSWORD=

# DemoShop MCP gateway credentials (bundled External Tools demo). REQUIRED by
# docker-compose.prod.yml (no demo/demo default). Internal-network only.
DEMO_MCP_USER=mcpservice
DEMO_MCP_PASSWORD=

# ======================
# Call Fabric Configuration
# ======================
# Encryption key for storing subscriber passwords securely
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SUBSCRIBER_PASSWORD_KEY=your-generated-fernet-key-here

# OAuth settings (optional - for advanced Fabric features)
FABRIC_CLIENT_ID=your-fabric-client-id
FABRIC_CLIENT_SECRET=your-fabric-client-secret
FABRIC_REDIRECT_URI=http://localhost:3000/callback

# ======================
# Frontend Configuration
# ======================
# These VITE_ prefixed vars are used by the React frontend.
# DEPLOY-M5: the app talks to /api and /socket.io on its OWN origin (see
# services/api.ts + services/websocket.ts). For a same-origin deploy behind
# nginx+TLS (the prod build), LEAVE VITE_API_URL/VITE_WS_URL BLANK — the app
# then uses relative URLs + window.location.origin, which resolve to https/wss
# automatically. Only set them for a split-origin dev setup, and use wss:// (not
# ws://) on any TLS page or the browser blocks it as mixed content.
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
VITE_SIGNALWIRE_HOST=your-space.signalwire.com
VITE_SIGNALWIRE_PHONE_NUMBER=+1234567890

# ======================
# Application Settings
# ======================
# DEPLOY-L1: default to production so a copy-paste operator doesn't ship the
# backend in dev mode (debugger, verbose errors). Set to `development` only for
# local work. docker-compose.prod.yml hardcodes production regardless.
FLASK_ENV=production

# ======================
# External URL (REQUIRED for local development)
# ======================
# Your ngrok HTTPS URL — used by backend to construct webhook URLs
# that SignalWire can reach (e.g., for SWML callbacks and queue routing)
EXTERNAL_URL=https://your-ngrok-url.ngrok-free.app

# Agent Base URL — externally accessible URL for AI agent transfers
# Should be the same ngrok URL (nginx routes /receptionist, /sales-ai, etc. to ai-agents)
AGENT_BASE_URL=https://your-ngrok-url.ngrok-free.app

# ======================
# Call Fabric Resources (set up in SignalWire Dashboard)
# ======================
# Agent Conference SWML Resource Address
# 1. Go to SignalWire Dashboard > Resources > Add New > Script > SWML Script
# 2. Set Request URL to: https://your-ngrok-url/api/conferences/agent-conference
# 3. Copy the assigned address (e.g., /public/agent-conference-swml)
AGENT_CONFERENCE_RESOURCE=/public/your-resource-address

# ======================
# Feature Flags
# ======================
ENABLE_CALL_RECORDING=true
ENABLE_TRANSCRIPTION=true
ENABLE_AI_SUMMARY=true
ENABLE_CALLBACK_SCHEDULING=false

# ======================
# Queue Configuration
# ======================
DEFAULT_QUEUE_TIMEOUT_SECONDS=300
DEFAULT_PRIORITY=5
MAX_QUEUE_DEPTH=50

# ======================
# Agent Configuration
# ======================
AGENT_IDLE_TIMEOUT_MINUTES=10
AGENT_WRAP_UP_TIME_SECONDS=30

# ======================
# Monitoring (Optional)
# ======================
SENTRY_DSN=
DATADOG_API_KEY=

# --- Debug telemetry capture (optional) -------------------------------------
# When DEBUG_WEBHOOK_ENABLED=true the AI agents tell SignalWire to POST
# turn-by-turn debug events to the backend, which writes them to
# backend/captures/debug-events.jsonl. Level 2 is high-volume (many POSTs per
# call) — turn it on only while debugging a specific call, then set back to
# false. Post-prompt payloads are always captured to backend/captures/.
#DEBUG_WEBHOOK_ENABLED=false
#DEBUG_WEBHOOK_LEVEL=2
#WEBHOOK_CAPTURE_DIR=/app/captures

# --- In-process workspace GC (HIGH-7) -------------------------------------
# The hourly/nightly workspace reaper used to be reachable only over HTTP from
# the demo-reset cron container, which lives in the operator-only (gitignored)
# docker-compose.demo.yml. Without that overlay nothing ever ran it and expired
# workspaces piled up until MAX_WORKSPACES 503'd every new visitor. The backend
# now schedules the same GC itself.
#
# Only active in hosted-demo mode — a clone-and-own deployment has one workspace
# that must never be GC'd, so the scheduler never starts there.
# 'false' hands GC back to an external scheduler (e.g. if you keep the cron
# container). Both paths are idempotent, so running both is safe.
WORKSPACE_GC_IN_PROCESS=true
# Sweep period in seconds. Default 3600 matches the cron container's hourly
# cadence. Clamped to [60, 86400]. The nightly safety pass (MAX_WORKSPACES cap
# + template hygiene) runs at most once per UTC day regardless of this.
WORKSPACE_GC_INTERVAL_SECONDS=3600
